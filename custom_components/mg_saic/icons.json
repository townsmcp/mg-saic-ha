{
  "entity": {
    "climate": {
      "climate": {
        "default": "mdi:thermostat",
        "state_attributes": {
          "preset_mode": {
            "default": "mdi:cancel",
            "state": {
              "low": "mdi:snowflake",
              "high": "mdi:fire",
              "front_windscreen": "mdi:car-defrost-front",
              "rear_windscreen": "mdi:car-defrost-rear"
            }
          }
        }
      }
    },
    "sensor": {
      "charging_data_freshness": {
        "default": "mdi:ev-station",
        "state": {
          "live": "mdi:check-circle-outline",
          "stale": "mdi:clock-alert-outline",
          "no_data": "mdi:help-circle-outline"
        }
      }
    }
  }
}
